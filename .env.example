# ── Database ──────────────────────────────────────────────────
# Neon serverless Postgres connection string (same driver as the WDA site).
DATABASE_URL=

# ── Google Sheets (content source) ────────────────────────────
# Full JSON of a Google service-account key, base64 or raw JSON,
# used to authenticate to the Sheets API v4.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Spreadsheet id from the sheet URL: .../spreadsheets/d/<THIS_ID>/edit
GOOGLE_SHEET_ID=

# ── Meta Instagram Graph API (publishing, API v21.0) ──────────
# Long-lived Instagram user access token (exchange/refresh flow).
INSTAGRAM_ACCESS_TOKEN=
# The IG user id — used in POST /{ig-user-id}/media and /media_publish.
INSTAGRAM_USER_ID=
# The Instagram business/creator account id (Business account → Settings → API).
INSTAGRAM_ACCOUNT_ID=

# ── App ───────────────────────────────────────────────────────
# Public base URL of this app (used for asset URLs passed to the IG API
# and for webhook callbacks). Defaults to http://localhost:3100.
APP_BASE_URL=
# Port the dev/start server binds to. Defaults to 3100 (never 3000 — that is
# the WDA site's port).
PORT=
